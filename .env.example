# Copier ce fichier en .env (ignoré par git) et remplir les valeurs. JAMAIS de valeur ici.

# Outil tools/publier-contenu.mjs (publication des contenus premium / PTS)
# Supabase › Project Settings › API (clé « service_role » : secrète, jamais dans le navigateur ni le dépôt)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Test des règles RLS (tools/test-rls.mjs) sur un Postgres 16 jetable, ex. postgres://postgres:postgres@localhost:5432/postgres
DATABASE_URL=

# Secrets des Edge Functions : à définir sur Supabase avec `npx supabase secrets set`, pas ici.
