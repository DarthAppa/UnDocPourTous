---
import Base from '../layouts/Base.astro';
---

<Base
    titre="Outils gratuits Albion Online"
    description="Six outils gratuits pour Albion Online, sans compte : encyclopédie, builder, guides, calendrier, cartes et recettes."
>
    <main class="wrap pt-8 pb-16 flex flex-col gap-8">
        <nav aria-label="Fil d’Ariane" class="crumbs">
            <span><a href="index.html">Accueil</a></span>
            <span><span class="sep" aria-hidden="true">/</span><a href="albion.html">Albion Online</a></span>
            <span
                ><span class="sep" aria-hidden="true">/</span><span aria-current="page">Outils gratuits</span></span
            >
        </nav>

        <section class="pt-3 pb-2 flex flex-col md:flex-row md:items-end md:justify-between gap-5 reveal">
            <div class="flex flex-col gap-3.5 lg:w-[850px]">
                <p class="font-mono font-medium text-[11px] text-mintFree">ALBION ONLINE / ACCÈS LIBRE</p>
                <h1 class="text-4xl sm:text-5xl lg:text-5xl font-semibold">Les outils gratuits.</h1>
                <p class="text-base leading-[1.6] text-textMuted">
                    Plus clairs et mieux rangés que le wiki de base. Choisissez un outil et lancez-vous.
                </p>
            </div>
            <div class="flex flex-col gap-2 md:items-end pb-[5px]">
                <p class="font-mono text-xs text-mintFree">6 OUTILS GRATUITS</p>
                <p class="text-[13px] text-textMuted">Sans compte</p>
            </div>
        </section>

        <section aria-label="Catalogue des outils gratuits">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <a href="albion-encyclopedie.html" class="tool-card card-link reveal" style="--d: 0s">
                    <div class="tool-card-visual">
                        <img
                            class="cover"
                            src="assets/img/maquette/outil-encyclopedie.webp"
                            alt=""
                            width="820"
                            height="328"
                            loading="lazy"
                        />
                        <span class="badge badge-free"><img src="assets/icons/check.svg" alt="" />GRATUIT</span>
                    </div>
                    <div class="flex flex-col gap-2.5 p-[22px] flex-1">
                        <h3 class="text-xl font-semibold leading-[1.2] md:h-12">Encyclopédie</h3>
                        <p class="text-[13px] leading-[1.6] text-textMuted md:h-[42px]">
                            Objets, équipements et ressources : les essentiels d’Albion, au même endroit.
                        </p>
                        <p class="flex items-center justify-between h-6 mt-auto">
                            <span class="card-hint text-[13px] font-semibold">Ouvrir →</span
                            ><span class="font-mono text-[10px] text-textFaint">ALBION ONLINE</span>
                        </p>
                    </div>
                </a>

                <a href="albion-builder.html" class="tool-card card-link reveal" style="--d: 0.1s">
                    <div class="tool-card-visual">
                        <img
                            class="cover"
                            src="assets/img/maquette/outil-builder.webp"
                            alt=""
                            width="820"
                            height="328"
                            loading="lazy"
                        />
                        <span class="badge badge-free"><img src="assets/icons/check.svg" alt="" />GRATUIT</span>
                    </div>
                    <div class="flex flex-col gap-2.5 p-[22px] flex-1">
                        <h3 class="text-xl font-semibold leading-[1.2] md:h-12">Builder général</h3>
                        <p class="text-[13px] leading-[1.6] text-textMuted md:h-[42px]">
                            Composez un équipement et explorez les synergies entre vos pièces.
                        </p>
                        <p class="flex items-center justify-between h-6 mt-auto">
                            <span class="card-hint text-[13px] font-semibold">Ouvrir →</span
                            ><span class="font-mono text-[10px] text-textFaint">ALBION ONLINE</span>
                        </p>
                    </div>
                </a>

                <div class="tool-card card-soon reveal" style="--d: 0.2s" aria-disabled="true">
                    <div class="tool-card-visual">
                        <img
                            class="cover"
                            src="assets/img/maquette/outil-guides.webp"
                            alt=""
                            width="820"
                            height="328"
                            loading="lazy"
                        />
                        <span class="badge badge-free"><img src="assets/icons/check.svg" alt="" />GRATUIT</span>
                    </div>
                    <div class="flex flex-col gap-2.5 p-[22px] flex-1">
                        <h3 class="text-xl font-semibold leading-[1.2] md:h-12">Guides</h3>
                        <p class="text-[13px] leading-[1.6] text-textMuted md:h-[42px]">
                            Des repères clairs pour prendre en main le jeu et choisir votre prochaine étape.
                        </p>
                        <p class="flex items-center justify-between h-6 mt-auto">
                            <span class="text-[13px] font-semibold text-textFaint">Bientôt</span
                            ><span class="font-mono text-[10px] text-textFaint">ALBION ONLINE</span>
                        </p>
                    </div>
                </div>

                <div class="tool-card card-soon reveal" style="--d: 0s" aria-disabled="true">
                    <div class="tool-card-visual">
                        <img
                            class="cover"
                            src="assets/img/maquette/outil-calendrier.webp"
                            alt=""
                            width="820"
                            height="328"
                            loading="lazy"
                        />
                        <span class="badge badge-free"><img src="assets/icons/check.svg" alt="" />GRATUIT</span>
                    </div>
                    <div class="flex flex-col gap-2.5 p-[22px] flex-1">
                        <h3 class="text-xl font-semibold leading-[1.2] md:h-12">Calendrier d’événements</h3>
                        <p class="text-[13px] leading-[1.6] text-textMuted md:h-[42px]">
                            Repérez les événements et préparez vos prochaines sorties en jeu.
                        </p>
                        <p class="flex items-center justify-between h-6 mt-auto">
                            <span class="text-[13px] font-semibold text-textFaint">Bientôt</span
                            ><span class="font-mono text-[10px] text-textFaint">ALBION ONLINE</span>
                        </p>
                    </div>
                </div>

                <div class="tool-card card-soon reveal" style="--d: 0.1s" aria-disabled="true">
                    <div class="tool-card-visual">
                        <img
                            class="cover"
                            src="assets/img/maquette/outil-cartes.webp"
                            alt=""
                            width="820"
                            height="328"
                            loading="lazy"
                        />
                        <span class="badge badge-free"><img src="assets/icons/check.svg" alt="" />GRATUIT</span>
                    </div>
                    <div class="flex flex-col gap-2.5 p-[22px] flex-1">
                        <h3 class="text-xl font-semibold leading-[1.2] md:h-12">Cartes et zones</h3>
                        <p class="text-[13px] leading-[1.6] text-textMuted md:h-[42px]">
                            Explorez les régions et retrouvez les zones utiles à votre aventure.
                        </p>
                        <p class="flex items-center justify-between h-6 mt-auto">
                            <span class="text-[13px] font-semibold text-textFaint">Bientôt</span
                            ><span class="font-mono text-[10px] text-textFaint">ALBION ONLINE</span>
                        </p>
                    </div>
                </div>

                <div class="tool-card card-soon reveal" style="--d: 0.2s" aria-disabled="true">
                    <div class="tool-card-visual">
                        <img
                            class="cover"
                            src="assets/img/maquette/outil-recettes.webp"
                            alt=""
                            width="820"
                            height="328"
                            loading="lazy"
                        />
                        <span class="badge badge-free"><img src="assets/icons/check.svg" alt="" />GRATUIT</span>
                    </div>
                    <div class="flex flex-col gap-2.5 p-[22px] flex-1">
                        <h3 class="text-xl font-semibold leading-[1.2] md:h-12">Recettes de craft</h3>
                        <p class="text-[13px] leading-[1.6] text-textMuted md:h-[42px]">
                            Retrouvez les ingrédients et les étapes pour fabriquer vos équipements.
                        </p>
                        <p class="flex items-center justify-between h-6 mt-auto">
                            <span class="text-[13px] font-semibold text-textFaint">Bientôt</span
                            ><span class="font-mono text-[10px] text-textFaint">ALBION ONLINE</span>
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <a href="albion-premium.html" class="invite card-link reveal">
            <span class="flex flex-col gap-2"
                ><span class="text-lg">Envie d’optimiser VOTRE compte ?</span
                ><span class="text-[13px] text-textMuted"
                    >Des outils personnalisés pour aller plus loin.</span
                ></span
            >
            <span class="card-hint text-sm font-semibold">Voir le Premium →</span>
        </a>
    </main>
</Base>
