---
// Pied de page commun à toutes les pages.
import { SITE } from '../site.js';
---

<footer class="site-footer">
    <div class="wrap flex flex-col gap-7">
        <div class="grid grid-cols-2 lg:flex lg:justify-between gap-x-6 gap-y-8">
            <div class="col-span-2 lg:col-span-1 lg:w-[430px] flex flex-col gap-3.5">
                <div class="flex items-center gap-3">
                    <img
                        class="brand-logo"
                        src="assets/img/marque/logo-header.webp"
                        alt=""
                        width="56"
                        height="56"
                    />
                    <span class="text-lg font-bold text-textLight">{SITE.nom}</span>
                </div>
                <p class="text-[13px] leading-[1.6] text-textMuted">
                    Des outils pour comprendre votre jeu.<br />Et aller plus loin, à votre rythme.
                </p>
            </div>
            <div class="lg:w-[180px] flex flex-col gap-3">
                <p class="footer-title">EXPLORER</p>
                <a href="index.html" class="footer-link">Accueil</a>
                <a href="index.html#jeux" class="footer-link">Jeux</a>
                <a href="albion-gratuit.html" class="footer-link">Outils gratuits</a>
            </div>
            <div class="lg:w-[180px] flex flex-col gap-3">
                <p class="footer-title">COMMUNAUTÉ</p>
                <a href="#" class="footer-link">Discord</a>
                <a href="connexion-pts.html" class="footer-link">Connexion</a>
                <a href="albion-premium.html" class="footer-link">Premium</a>
            </div>
            <div class="col-span-2 lg:col-span-1 lg:w-[220px] flex flex-col gap-3">
                <p class="footer-title">INFORMATIONS</p>
                <a href="mentions-legales.html" class="footer-link">Mentions légales</a>
                <a href="confidentialite.html" class="footer-link">Confidentialité</a>
                <a href="conditions.html" class="footer-link">Conditions d’utilisation</a>
            </div>
        </div>
        <div
            class="border-t border-cardBorder pt-[22px] flex flex-col sm:flex-row sm:justify-between gap-2 text-[11px] text-textFaint"
        >
            <p>© {SITE.nom}. Non affilié aux éditeurs des jeux cités.</p>
            <p class="font-mono">FAIT POUR LES JOUEURS.</p>
        </div>
    </div>
</footer>
